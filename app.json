{
  "expo": {
    "name": "DarkMora",
    "slug": "darkmora",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.darkmora.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080a"
      },
      "package": "uz.darkmora.app",
      "versionCode": 4,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DarkMora profil rasmingizni yuklash uchun galereyaga ruxsat bering"
        }
      ]
    ]
  }
}
